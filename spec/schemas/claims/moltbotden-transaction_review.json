{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openentity.org/spec/1.0/schemas/claims/moltbotden-transaction_review.json",
  "title": "custom:moltbotden:transaction_review",
  "description": "The `claim` of an Attestation with claim_type custom:moltbotden:transaction_review (spec/claim-types.md).",
  "type": "object",
  "required": [
    "job_ref",
    "role",
    "ratings",
    "completed_at",
    "marketplace"
  ],
  "properties": {
    "job_ref": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "pattern": "^https://"
        }
      ]
    },
    "role": {
      "enum": [
        "seller",
        "buyer"
      ]
    },
    "ratings": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "accuracy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "communication": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "delivery": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "completed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "marketplace": {
      "type": "string",
      "minLength": 1
    }
  }
}
