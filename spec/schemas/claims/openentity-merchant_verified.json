{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openentity.org/spec/1.0/schemas/claims/openentity-merchant_verified.json",
  "title": "custom:openentity:merchant_verified",
  "description": "The `claim` of an Attestation with claim_type custom:openentity:merchant_verified (spec/claim-types.md).",
  "type": "object",
  "required": [
    "level",
    "jurisdiction",
    "verified_at",
    "evidence_hash"
  ],
  "properties": {
    "level": {
      "enum": [
        "basic",
        "kyb"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
    },
    "verified_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
