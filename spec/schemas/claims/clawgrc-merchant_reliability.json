{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openentity.org/spec/1.0/schemas/claims/clawgrc-merchant_reliability.json",
  "title": "custom:clawgrc:merchant_reliability",
  "description": "The `claim` of an Attestation with claim_type custom:clawgrc:merchant_reliability (spec/claim-types.md).",
  "type": "object",
  "required": [
    "window",
    "orders",
    "distinct_reporters",
    "fulfilled_rate",
    "refund_rate",
    "evidence_hash"
  ],
  "properties": {
    "window": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "orders": {
      "type": "integer",
      "minimum": 0
    },
    "distinct_reporters": {
      "type": "integer",
      "minimum": 0
    },
    "fulfilled_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "refund_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
