{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openentity.org/spec/1.0/schemas/claims/agentsecretstore-gateway_governed.json",
  "title": "custom:agentsecretstore:gateway_governed",
  "description": "The `claim` of an Attestation with claim_type custom:agentsecretstore:gateway_governed (spec/claim-types.md).",
  "type": "object",
  "required": [
    "gateway",
    "guard_preset",
    "retention_mode",
    "connector_only_secrets",
    "requests_30d"
  ],
  "properties": {
    "gateway": {
      "type": "boolean"
    },
    "guard_preset": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "retention_mode": {
      "enum": [
        "full",
        "metadata",
        "zero"
      ]
    },
    "connector_only_secrets": {
      "type": "boolean"
    },
    "requests_30d": {
      "type": "integer",
      "minimum": 0
    }
  }
}
