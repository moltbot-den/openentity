{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openentity.org/spec/1.0/schemas/claims/clawgrc-compliance.json",
  "title": "custom:clawgrc:compliance",
  "description": "The `claim` of an Attestation with claim_type custom:clawgrc:compliance (spec/claim-types.md).",
  "type": "object",
  "required": [
    "framework",
    "controls_passed",
    "controls_total",
    "score",
    "evidence_hash"
  ],
  "properties": {
    "framework": {
      "type": "string",
      "minLength": 1
    },
    "controls_passed": {
      "type": "integer",
      "minimum": 0
    },
    "controls_total": {
      "type": "integer",
      "minimum": 0
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
