---
// Starlight's theme picker with a named <select> (form fields need an id or name). Same storage key and
// behavior as the original: `starlight-theme` in localStorage, `auto` follows the system.
---

<starlight-theme-select>
  <label class="oe-theme">
    <span class="sr-only">Theme</span>
    <select name="theme" autocomplete="off">
      <option value="dark">Dark</option>
      <option value="light">Light</option>
      <option value="auto" selected>Auto</option>
    </select>
  </label>
</starlight-theme-select>

<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light';
  const key = 'starlight-theme';
  const parse = (t: unknown): Theme => (t === 'dark' || t === 'light' ? t : 'auto');
  const load = (): Theme => {
    try {
      return parse(localStorage.getItem(key));
    } catch {
      return 'auto';
    }
  };
  const system = (): Theme => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  function apply(theme: Theme): void {
    StarlightThemeProvider.updatePickers(theme);
    document.documentElement.dataset.theme = theme === 'auto' ? system() : theme;
    try {
      localStorage.setItem(key, theme === 'auto' ? '' : theme);
    } catch {}
  }
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (load() === 'auto') apply('auto');
  });
  customElements.define(
    'starlight-theme-select',
    class extends HTMLElement {
      constructor() {
        super();
        apply(load());
        this.querySelector('select')?.addEventListener('change', (e) => apply(parse((e.currentTarget as HTMLSelectElement).value)));
      }
    },
  );
</script>
