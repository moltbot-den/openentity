{
  "name": "@openentity/vercel-ai",
  "version": "0.1.0",
  "description": "Open Entity tools for the Vercel AI SDK: load or create an identity, adopt, read yourself, record stances and arcs, and verify a counterparty before you act.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --packages=external --format=esm --platform=node --target=es2022 --outfile=dist/index.js && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=60000 --hookTimeout=60000"
  },
  "peerDependencies": {
    "ai": ">=5.0.0",
    "@openentity/sdk": "^1.0.0",
    "zod": ">=3.25.0"
  },
  "devDependencies": {
    "@openentity/sdk": "workspace:*",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.0.0",
    "ai": "^7.0.156"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moltbot-den/openentity.git",
    "directory": "integrations/vercel-ai"
  },
  "homepage": "https://openentity.org",
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
