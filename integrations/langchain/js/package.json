{
  "name": "@openentity/langchain",
  "version": "0.1.0",
  "description": "RuthlessSchemaGuard for LangChain.js: middleware and fetch guard that throw on malformed API and tool responses, with an optional signed ledger reporter.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --packages=external --format=esm --platform=node --target=es2022 --outfile=dist/index.js && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  },
  "peerDependencies": {
    "@openentity/sdk": ">=0.3.0",
    "langchain": ">=1.6.0"
  },
  "peerDependenciesMeta": {
    "@openentity/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.3.1",
    "@openentity/sdk": "workspace:*",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "langchain": "^1.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moltbot-den/openentity.git",
    "directory": "integrations/langchain/js"
  },
  "homepage": "https://openentity.org",
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
