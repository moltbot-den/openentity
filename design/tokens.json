{
  "$comment": "Source of truth for the OpenEntity app. Run `node design/generate.mjs` to rewrite design/generated/. Shell colors come from site/src/styles/theme.css.",
  "color": {
    "light": {
      "bg": "#ffffff", "panel": "#f6f8f7", "hairline": "#d3d9d6",
      "text": "#111716", "textSecondary": "#3e4644", "textMuted": "#5c6562",
      "accent": "#0a6b4c", "accentLow": "#e3f2eb", "onAccent": "#ffffff",
      "danger": "#b3261e", "onDanger": "#ffffff", "warn": "#a1430f", "ok": "#0a6b4c",
      "product": { "den": "#c4202f", "safety": "#1d5fc4", "keys": "#8a5a00", "governance": "#6b3fc0" }
    },
    "dark": {
      "bg": "#0e1312", "panel": "#151b19", "hairline": "#303a36",
      "text": "#e9eeec", "textSecondary": "#aeb7b3", "textMuted": "#8a938f",
      "accent": "#5ccb9f", "accentLow": "#12291f", "onAccent": "#0e1312",
      "danger": "#ff8a80", "onDanger": "#0e1312", "warn": "#f0a36b", "ok": "#5ccb9f",
      "product": { "den": "#ff5c64", "safety": "#6aa8ff", "keys": "#e0b04a", "governance": "#b48cff" }
    }
  },
  "type": {
    "$comment": "size in pt (iOS) and sp (Android). ios is the SwiftUI Font.TextStyle that scales with Dynamic Type up to AX5; android is the Material 3 role that scales with font scale. mono styles use the system monospaced design.",
    "largeTitle": { "size": 34, "weight": 700, "line": 41, "ios": "largeTitle", "android": "headlineLarge" },
    "title":      { "size": 28, "weight": 700, "line": 34, "ios": "title", "android": "headlineMedium" },
    "title2":     { "size": 22, "weight": 600, "line": 28, "ios": "title2", "android": "titleLarge" },
    "title3":     { "size": 20, "weight": 600, "line": 25, "ios": "title3", "android": "titleMedium" },
    "headline":   { "size": 17, "weight": 600, "line": 22, "ios": "headline", "android": "titleSmall" },
    "body":       { "size": 17, "weight": 400, "line": 22, "ios": "body", "android": "bodyLarge" },
    "callout":    { "size": 16, "weight": 400, "line": 21, "ios": "callout", "android": "bodyMedium" },
    "subheadline":{ "size": 15, "weight": 400, "line": 20, "ios": "subheadline", "android": "bodyMedium" },
    "footnote":   { "size": 13, "weight": 400, "line": 18, "ios": "footnote", "android": "bodySmall" },
    "caption":    { "size": 12, "weight": 500, "line": 16, "ios": "caption", "android": "labelMedium" },
    "mono":       { "size": 15, "weight": 400, "line": 20, "ios": "subheadline", "android": "bodyMedium", "mono": true },
    "monoSmall":  { "size": 13, "weight": 400, "line": 18, "ios": "footnote", "android": "bodySmall", "mono": true },
    "code":       { "size": 28, "weight": 600, "line": 34, "ios": "title", "android": "headlineMedium", "mono": true }
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "radius": { "sm": 8, "md": 12, "lg": 20, "sheet": 28, "pill": 999 },
  "motion": {
    "$comment": "Durations in ms. reduceMotion replaces every transform or draw animation with a plain cross-fade of this length.",
    "fast": 120, "base": 220, "slow": 420,
    "sealAssemble": 700, "approveHold": 900, "countdownTick": 1000,
    "reduceMotionFade": 150
  },
  "haptics": {
    "$comment": "Semantic event to platform feedback. ios is UINotificationFeedbackGenerator / UIImpactFeedbackGenerator; android is HapticFeedbackConstants.",
    "approve":        { "ios": "success", "android": "CONFIRM" },
    "deny":           { "ios": "warning", "android": "REJECT" },
    "verifyFailed":   { "ios": "error", "android": "REJECT" },
    "holdProgress":   { "ios": "rigid", "android": "CLOCK_TICK" },
    "selection":      { "ios": "selection", "android": "SEGMENT_TICK" }
  }
}
