{
  "name": "@openentity/mcp",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openentity-mcp": "dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/stdio.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/stdio.js --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/stdio.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache-mcp --testTimeout=60000 --hookTimeout=60000"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openentity/sdk": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
